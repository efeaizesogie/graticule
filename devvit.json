{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "graticuledaily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Graticule: post the next map now",
        "description": "Opens the next day's map immediately",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-next"
      },
      {
        "label": "Graticule: view map suggestions",
        "description": "Datasets suggested by players",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/suggestions"
      }
    ]
  },
  "forms": {
    "suggestionsView": "/internal/form/suggestions-view"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-map": {
        "endpoint": "/internal/scheduler/daily",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "graticuledaily_dev"
  }
}